# Never commit real secrets. Copy this file to .env locally.
STEP_API_KEY=replace-with-your-stepfun-key

# General StepFun OpenAI-compatible endpoint:
STEP_API_BASE_URL=https://api.stepfun.com/v1

# If your account uses Step Plan for coding-agent scenarios, use:
# STEP_API_BASE_URL=https://api.stepfun.com/step_plan/v1

STEP_API_MODEL=step-3.5-flash
STEP_API_TIMEOUT_SECONDS=60
